---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
---
<Base
  lang="en"
  title="Physiotherapy Fees Paris 16 – Reimbursement & Insurance | A. Mischenko"
  description={`Physiotherapy fees in Paris 16th: first session €${site.prices.first}, follow-up €${site.prices.session}. Registered with French health insurance (Carte Vitale accepted). Invoices for international insurance.`}
  crumbs={[{ name: 'Home', href: '/en/' }, { name: 'Fees', href: '/en/fees/' }]}
>
  <PageHero
    lang="en"
    eyebrow="Fees"
    title="Fees and reimbursement"
    lead="Clear fees, displayed in advance. The practice is registered with the French health insurance system (conventionnée, with additional fees)."
  />
  <section class="section">
    <div class="wrap narrow prose">
      <table class="table">
        <tbody>
          <tr><th scope="row">First session (assessment and treatment)</th><td>€{site.prices.first}</td></tr>
          <tr><th scope="row">Follow-up session</th><td>€{site.prices.session}</td></tr>
          <tr><th scope="row">Fitness &amp; reconditioning (not reimbursed)</th><td>On request</td></tr>
        </tbody>
      </table>

      <h2>Reimbursement</h2>
      <ul>
        <li><strong>French health insurance:</strong> the standard rate is partly reimbursed with a doctor’s prescription; Carte Vitale accepted.</li>
        <li><strong>Top-up insurance (mutuelle):</strong> may cover the remainder and the additional fee depending on your policy.</li>
        <li><strong>International or private insurance:</strong> an invoice is provided for you to claim reimbursement.</li>
      </ul>

      <h2>Payment</h2>
      <p>Cheque, cash or bank transfer. <strong>Card payments are not accepted.</strong></p>

      <h2>What to bring</h2>
      <ul>
        <li>Your prescription, if you have one;</li>
        <li>Carte Vitale or insurance details;</li>
        <li>Any imaging or reports (X-ray, MRI, operative report);</li>
        <li>Comfortable clothing.</li>
      </ul>
    </div>
  </section>
  <CtaBand lang="en" />
</Base>
