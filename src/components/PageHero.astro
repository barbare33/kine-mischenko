---
import { site, ui, type Lang } from '../data/site';

interface Props { lang?: Lang; eyebrow: string; title: string; lead: string; showCta?: boolean }
const { lang = 'fr', eyebrow, title, lead, showCta = true } = Astro.props;
const t = ui[lang];
---
<section class="phero">
  <img class="phero__art" src="/img/line-right.png" alt="" width="798" height="894" />
  <div class="wrap phero__in">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <hr class="rule" />
    <p class="lead">{lead}</p>
    {showCta && (
      <div class="btn-row">
        <a class="btn btn--primary" href={site.doctolib} target="_blank" rel="noopener">{t.book}</a>
        <a class="btn btn--ghost" href={`tel:${site.phone}`}>{lang === 'fr' ? site.phoneDisplay : site.phoneDisplayIntl}</a>
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    position: relative; overflow: hidden;
    background: var(--sand);
    padding: clamp(48px, 7vw, 96px) 0 clamp(56px, 8vw, 104px);
  }
  .phero__in { position: relative; z-index: 1; }
  .phero h1 { max-width: 760px; }
  .phero .eyebrow { color: var(--ink-soft); }
  .phero__art {
    position: absolute; bottom: 0; right: clamp(8px, 4vw, 64px);
    width: clamp(160px, 22vw, 300px); height: auto; pointer-events: none;
  }
  @media (max-width: 900px) { .phero__art { display: none; } }
</style>
