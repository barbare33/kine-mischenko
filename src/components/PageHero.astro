---
import { site, ui, type Lang } from '../data/site';

interface Props { lang?: Lang; eyebrow: string; title: string; lead: string; showCta?: boolean }
const { lang = 'fr', eyebrow, title, lead, showCta = true } = Astro.props;
const t = ui[lang];
---
<section class="phero">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <hr class="rule" />
    <p class="lead">{lead}</p>
    {showCta && (
      <div class="btn-row">
        <a class="btn btn--primary" href={site.doctolib} target="_blank" rel="noopener">{t.book}</a>
        <a class="btn btn--ghost" href={`tel:${site.phone}`}>{lang === 'fr' ? site.phoneDisplay : site.phoneDisplayIntl}</a>
      </div>
    )}
  </div>
</section>

<style>
  .phero { padding: clamp(40px, 6vw, 80px) 0 clamp(48px, 7vw, 96px); border-bottom: 1px solid var(--stone); }
  .phero h1 { max-width: 880px; }
</style>
