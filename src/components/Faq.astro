---
import { ui, type Lang } from '../data/site';

export interface QA { q: string; a: string }
interface Props { items: QA[]; lang?: Lang; title?: string }
const { items, lang = 'fr', title } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<section class="section faq-sec">
  <div class="wrap narrow faq">
    <span class="eyebrow">FAQ</span>
    <h2>{title ?? ui[lang].faq}</h2>
    {items.map((i) => (
      <details>
        <summary>{i.q}</summary>
        <div set:html={i.a} />
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
