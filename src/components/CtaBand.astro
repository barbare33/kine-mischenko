---
import { site, ui, type Lang } from '../data/site';

interface Props { lang?: Lang; title?: string; text?: string }
const { lang = 'fr', title, text } = Astro.props;
const fr = lang === 'fr';
---
<section class="section cta">
  <img class="cta__art" src="/img/line-left.png" alt="" width="414" height="1104" loading="lazy" />
  <div class="wrap cta__in">
    <h2>{title ?? (fr ? 'Prendre rendez-vous au cabinet' : 'Book an appointment')}</h2>
    <p>{text ?? (fr
      ? `${site.address.street}, ${site.address.postalCode} Paris — à 3 minutes du métro Ranelagh. Réservation en ligne sur Doctolib ou par téléphone.`
      : `${site.address.street}, ${site.address.postalCode} Paris — 3 minutes from Ranelagh metro. Book online via Doctolib or by phone. English spoken.`)}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={site.doctolib} target="_blank" rel="noopener">{ui[lang].book}</a>
      <a class="btn btn--ghost" href={`tel:${site.phone}`}>{fr ? site.phoneDisplay : site.phoneDisplayIntl}</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; background: var(--sand); text-align: center; }
  .cta__in { position: relative; z-index: 1; }
  .cta p { max-width: 560px; margin: 0 auto; color: var(--ink-soft); }
  .cta .btn-row { justify-content: center; }
  .cta__art {
    position: absolute; bottom: 0; left: clamp(8px, 5vw, 80px);
    width: clamp(70px, 9vw, 120px); height: auto; pointer-events: none;
  }
  @media (max-width: 720px) { .cta__art { display: none; } }
</style>
