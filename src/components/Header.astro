---
import { nav, ui, site, alternateOf, type Lang } from '../data/site';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = ui[lang];
const alt = alternateOf(path);
const otherLang = lang === 'fr' ? 'en' : 'fr';
const switchHref = alt[otherLang] ?? (otherLang === 'en' ? '/en/' : '/');
const home = lang === 'fr' ? '/' : '/en/';
---
<a class="skip" href="#main">{t.skip}</a>
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href={home}>
      <span class="brand__name">{site.name}</span>
      <span class="brand__sub">{lang === 'fr' ? 'Kinésithérapeute · Paris 16' : 'Physiotherapist · Paris 16'}</span>
    </a>

    <nav class="nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'} id="nav">
      <ul>
        {nav[lang].map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            {item.children ? (
              <>
                <button class="nav__link nav__toggle" aria-expanded="false" type="button">{item.label}</button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="nav__link" href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
        <li><a class="nav__link nav__lang" href={switchHref} hreflang={otherLang} lang={otherLang}>{t.langSwitch}</a></li>
      </ul>
      <a class="btn btn--primary nav__cta" href={site.doctolib} target="_blank" rel="noopener">{t.book}</a>
    </nav>

    <button class="burger" type="button" aria-controls="nav" aria-expanded="false">
      <span class="sr-only">{t.menu}</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const navEl = document.getElementById('nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
    document.body.classList.toggle('no-scroll', !open);
  });
  document.querySelectorAll<HTMLButtonElement>('.nav__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLButtonElement>('.nav__toggle[aria-expanded="true"]').forEach((btn) => {
      if (!btn.parentElement?.contains(e.target as Node)) btn.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    /* Fond opaque, sans backdrop-filter : celui-ci casserait le position:fixed du menu mobile. */
    background: var(--ivory);
    border-bottom: 1px solid var(--stone);
  }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .brand { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; line-height: 1.1; white-space: nowrap; }
  .brand__name { font-size: 0.95rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  .brand__sub { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }

  .nav { display: flex; align-items: center; gap: 16px; }
  .nav > ul { display: flex; align-items: center; gap: 0; list-style: none; margin: 0; padding: 0; }
  .nav li { margin: 0; position: relative; }
  .nav__link {
    display: block; padding: 0.5rem 0.55rem; font-size: 0.68rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); white-space: nowrap;
    text-decoration: none; background: none; border: 0; font-family: inherit; cursor: pointer;
  }
  .nav__link:hover, .nav__link[aria-current='page'] { color: var(--accent); }
  .nav__link[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  .nav__toggle::after { content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 8px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: translateY(-3px) rotate(45deg); }
  .nav__lang { color: var(--muted); }

  .sub {
    display: none; position: absolute; top: calc(100% + 8px); left: 0; min-width: 300px;
    list-style: none; margin: 0; padding: 10px; background: var(--white);
    border: 1px solid var(--stone); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .sub a { display: block; padding: 0.6rem 0.8rem; font-size: 0.9rem; color: var(--ink); text-decoration: none; border-radius: var(--radius); }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--sand); color: var(--accent); }
  .nav__toggle[aria-expanded='true'] + .sub { display: block; }
  @media (hover: hover) and (min-width: 1141px) {
    .has-sub:hover .sub { display: block; }
    .has-sub .sub::before { content: ''; position: absolute; top: -10px; left: 0; right: 0; height: 10px; }
  }

  .burger { display: none; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; position: relative; }
  .burger span[aria-hidden] { position: absolute; left: 10px; right: 10px; height: 1px; background: var(--ink); transition: transform 0.2s ease; }
  .burger span[aria-hidden]:nth-of-type(2) { top: 18px; }
  .burger span[aria-hidden]:nth-of-type(3) { top: 26px; }
  .burger[aria-expanded='true'] span[aria-hidden]:nth-of-type(2) { transform: translateY(4px) rotate(45deg); }
  .burger[aria-expanded='true'] span[aria-hidden]:nth-of-type(3) { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 1140px) {
    .burger { display: block; }
    .nav {
      display: none; position: fixed; inset: 76px 0 0 0; background: var(--ivory);
      flex-direction: column; align-items: stretch; padding: 24px var(--gutter) 120px; overflow-y: auto;
    }
    .nav.is-open { display: flex; }
    .nav > ul { flex-direction: column; align-items: stretch; }
    .nav__link { font-size: 0.95rem; padding: 0.8rem 0; text-align: left; width: 100%; }
    .nav__lang { margin-top: 1rem; }
    .sub { position: static; box-shadow: none; border: 0; padding: 0 0 0.5rem 0; background: transparent; min-width: 0; }
    .sub a { font-size: 1rem; padding: 0.5rem 0 0.5rem 1rem; border-left: 1px solid var(--stone); border-radius: 0; }
    .nav__cta { margin-top: 1.5rem; }
  }
  :global(body.no-scroll) { overflow: hidden; }
</style>
